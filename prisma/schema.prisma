// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feedback {
  id              String   @id @default(cuid())
  representativeId String?  // rep ID from kenya-data (optional)
  countyName       String?  // county name (optional)
  category         String   // Complaint | Suggestion | Observation | Question | Appreciation
  title            String   // short title of feedback
  description      String   // detailed description
  submitterName    String?  // optional name
  submitterEmail   String?  // optional email for follow-up
  submitterCounty  String?  // submitter's county of residence
  isAnonymous      Boolean  @default(true) // whether to display anonymously
  status           String   @default("Submitted") // Submitted | Under Review | Acknowledged | Resolved
  priority         String   @default("Normal") // Normal | High | Urgent
  sourceUrl        String?  // optional source/evidence URL
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@index([countyName])
}

// Admin-uploaded or link-submitted oversight resources (OAG, CoB, EACC, TI-Kenya).
model Resource {
  id          String   @id @default(cuid())
  source      String   // "OAG" | "CoB" | "EACC" | "TI-Kenya" | "Other"
  kind        String   // "document" | "video" | "link"
  title       String
  description String?
  url         String
  fileName    String?
  fileSize    Int?
  mimeType    String?
  thumbnailUrl String?
  durationLabel String?
  fiscalYear  String?
  countyName  String?
  reportType  String?
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([source, kind])
  @@index([published])
}
