{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "devCommand": "bun run dev",
  "outputDirectory": ".next",
  "regions": ["fra1"],
  "functions": {
    "src/app/api/ai-assistant/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/admin/extract-finance/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/admin/refresh-parliament/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/finance-alerts/check/route.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/api/finance-audit",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/api/parliament",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/api/stats",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/logo.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/county-finance/:name*",
      "destination": "/finance-audit/county/:name*",
      "permanent": true
    },
    {
      "source": "/reps",
      "destination": "/representatives",
      "permanent": true
    },
    {
      "source": "/dashboard",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/open-data",
      "destination": "/api/finance-audit"
    }
  ],
  "crons": [
    {
      "path": "/api/finance-alerts/check",
      "schedule": "*/15 * * * *"
    }
  ],
  "github": {
    "silent": true
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_BASE_URL": "https://kenya-govdash.vercel.app"
    }
  }
}
