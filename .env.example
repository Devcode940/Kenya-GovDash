# Copy to .env and fill in. Never commit .env (it holds secrets).
# ADMIN_PASSWORD_HASH + JWT_SECRET are required in every environment.

# =============================================================================
# DATABASE — pick one mode (must match prisma/schema.prisma provider)
# =============================================================================

# --- Mode A: Local SQLite (default for development) ---
DATABASE_URL="file:./dev.db"
# prisma/schema.prisma → provider = "sqlite"

# --- Mode B: Turso (recommended production with Vercel; still provider = "sqlite") ---
# Create: turso db create kenya-govdash
# URL:    turso db show kenya-govdash --url
# Token:  turso db tokens create kenya-govdash
# DATABASE_URL="libsql://kenya-govdash-XXXX.turso.io?authToken=eyJ..."

# --- Mode C: Supabase PostgreSQL (change schema provider to "postgresql" first) ---
# 1. supabase.com → New project → Settings → Database → Connection string
# 2. Edit prisma/schema.prisma: provider = "postgresql"
# 3. Push schema (use DIRECT host, not pooler):
#      export DATABASE_URL="postgresql://postgres.REF:PASS@db.REF.supabase.co:5432/postgres"
#      npx prisma generate && npx prisma db push
# 4. App / Vercel (prefer POOLER / transaction mode):
# DATABASE_URL="postgresql://postgres.REF:PASS@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# =============================================================================
# ADMIN AUTH (REQUIRED — no defaults)
# =============================================================================
# Password hash:
#   node -e "console.log(require('bcryptjs').hashSync('your-strong-password', 12))"
ADMIN_PASSWORD_HASH=""
# JWT secret (min 32 chars):
#   openssl rand -hex 32
JWT_SECRET=""

# Set to 1 only when a reverse proxy overwrites X-Forwarded-For (Vercel, Caddy).
TRUST_PROXY="0"

# =============================================================================
# WHISTLEBLOWER (optional until you enable the feature)
# =============================================================================
# Generate offline: node scripts/whistleblower_gen_keys.mjs --out ./wb-keys
WHISTLEBLOWER_PUBLIC_KEY=""

# Shared rate-limit store for serverless (optional; Upstash Redis REST)
RATE_LIMIT_KV_URL=""
RATE_LIMIT_KV_TOKEN=""

# =============================================================================
# AI ASSISTANT (optional)
# =============================================================================
# Get key: https://console.mistral.ai/
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"

# =============================================================================
# EMAIL (optional — finance alerts + feedback)
# =============================================================================
RESEND_API_KEY=""
MAIL_FROM="Kenya GovDash <noreply@yourdomain.com>"
MAIL_REPLY_TO="support@yourdomain.com"

# Cron auth for /api/finance-alerts/check (Vercel Cron or external cron)
CRON_SECRET=""

# Public site URL (metadata, email links)
# Local:  http://localhost:3000
# Vercel: https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
