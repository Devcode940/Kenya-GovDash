# Copy to .env and fill in. Never commit .env (it holds secrets).
# Production refuses to start without ADMIN_PASSWORD_HASH + JWT_SECRET.

# Database (SQLite for dev, PostgreSQL/Turso for production)
DATABASE_URL="file:./dev.db"

# Admin auth (REQUIRED in production)
# Generate: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH=""
# Generate: openssl rand -hex 32 (min 32 chars)
JWT_SECRET=""

# Set to 1 only when a reverse proxy overwrites X-Forwarded-For (Vercel, Caddy).
# Required for correct per-IP rate limiting; leave 0 on direct exposure.
TRUST_PROXY="0"

# Whistleblower E2E encryption (required for secure submission; without it the
# whistleblower endpoints return 501). Generate OFFLINE:
#   node scripts/whistleblower_gen_keys.mjs --out ./wb-keys
# then paste the single-line base64 from public.spki.b64 here.
WHISTLEBLOWER_PUBLIC_KEY=""

# Shared rate-limit store for serverless (optional; Upstash Redis REST).
# Without these, the in-memory limiter is used (single-instance only).
RATE_LIMIT_KV_URL=""
RATE_LIMIT_KV_TOKEN=""

# AI Assistant (optional — at least one recommended)
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"

# Email notifications (optional)
RESEND_API_KEY=""
MAIL_FROM="Kenya GovDash <noreply@yourdomain.com>"
MAIL_REPLY_TO="support@yourdomain.com"

# Cron auth for /api/finance-alerts/check
CRON_SECRET=""

# Public URL (links, metadata)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
